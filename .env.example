DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b

# 多智能体角色模型（基于 Ollama 本地模型）
OLLAMA_ROUTER_MODEL=qwen3:8b
OLLAMA_RETRIEVER_MODEL=qwen3:8b
OLLAMA_REVIEWER_MODEL=deepseek-r1:8b
OLLAMA_ANSWER_MODEL=deepseek-r1:8b
MAS_ENABLED=1
GRAPH_HOPS=2

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
USE_HASH_EMBEDDINGS=0
VECTORSTORE_DIR=./data/vectorstore

# Milvus 向量库（默认启用；不可用时可临时切换为 faiss）
VECTOR_BACKEND=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=public_health_chunks
MILVUS_HNSW_M=32
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF=64
MILVUS_FALLBACK_TO_FAISS=1

REDIS_URL=redis://127.0.0.1:6379/0

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
