DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b

# 多智能体角色模型（基于 Ollama 本地模型）
OLLAMA_ROUTER_MODEL=qwen3:8b
OLLAMA_RETRIEVER_MODEL=qwen3:8b
OLLAMA_REVIEWER_MODEL=deepseek-r1:8b
OLLAMA_ANSWER_MODEL=deepseek-r1:8b
MAS_ENABLED=1
MAS_MAX_TOOL_CALLS=4
MAS_TOOL_MAX_CONCURRENCY=4
MAS_TOOL_TIMEOUT_SECONDS=12
# 联网检索：公开网页仅作为辅助证据，生产环境可按合规要求关闭
WEB_SEARCH_ENABLED=1
WEB_SEARCH_TIMEOUT_SECONDS=8
# LangSmith 可观测性：配置 API Key 后将启用 Agent 与工具链路追踪。
LANGSMITH_TRACING=0
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=medical-rag-agent
LANGSMITH_DASHBOARD_URL=
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# 重排序模型：首次问答会自动下载 Cross-Encoder；离线环境可设为 0，保留向量召回。
RERANKER_ENABLED=1
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_CANDIDATE_K=20
RERANKER_CANDIDATE_MULTIPLIER=5
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
# 会话记忆：超过短期窗口的历史会压缩为滚动摘要，并保存可召回的长期研究记忆。
MEMORY_ENABLED=1
MEMORY_SHORT_TERM_MESSAGE_LIMIT=8
MEMORY_SUMMARY_MAX_CHARS=1200
MEMORY_CONTEXT_MAX_CHARS=3000
MEMORY_LONG_TERM_TOP_K=3
GRAPH_HOPS=2

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
USE_HASH_EMBEDDINGS=0
VECTORSTORE_DIR=./data/vectorstore

# Milvus 向量库（默认启用；不可用时可临时切换为 faiss）
VECTOR_BACKEND=milvus
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=public_health_chunks
MILVUS_HNSW_M=32
MILVUS_HNSW_EF_CONSTRUCTION=200
MILVUS_HNSW_EF=64
MILVUS_FALLBACK_TO_FAISS=1

REDIS_URL=redis://127.0.0.1:6379/0

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j